{
  "$schema_note": "Fuente única del sistema visual de T-Max. Cada plataforma genera sus constantes a partir de este archivo (TS para iOS, CSS para Tizen/webOS, BrightScript para Roku). No editar valores en las plataformas.",
  "version": 1,
  "font": {
    "family": "Manrope",
    "license": "SIL Open Font License 1.1",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "note": "Roku necesita TTF estáticos: incluir solo los 3-4 pesos usados."
  },
  "color": {
    "bg": {
      "base": "#0A0B0D",
      "panel": "#14161A",
      "raised": "#1C1F24",
      "hover": "#252930"
    },
    "line": {
      "subtle": "#23272E",
      "strong": "#343943"
    },
    "text": {
      "primary": "#F4F5F7",
      "secondary": "#A4AAB4",
      "tertiary": "#6C727C",
      "onAccent": "#0A0B0D"
    },
    "accent": {
      "base": "#D7F36A",
      "pressed": "#C3E054",
      "soft": "#D7F36A26"
    },
    "live": {
      "base": "#FF5A4E"
    },
    "success": {
      "base": "#4ADE80"
    },
    "warning": {
      "base": "#FBBF24"
    },
    "danger": {
      "base": "#F87171"
    },
    "overlay": {
      "panel": {
        "value": "#121418E6",
        "blur": 0,
        "note": "Paneles sobre el video en TODAS las plataformas. Sin desenfoque para ahorrar RAM/GPU (decisión 2026-11-22)."
      },
      "chip": {
        "value": "#121418E6"
      },
      "scrimTop": {
        "from": "#000000B3",
        "to": "#00000000"
      },
      "scrimBottom": {
        "from": "#00000000",
        "to": "#000000CC"
      }
    }
  },
  "radius": {
    "sm": 8,
    "md": 14,
    "lg": 20,
    "xl": 28,
    "pill": 999,
    "note": "Roku: esquinas con imágenes 9-patch (.9.png) por radio y por resolución; imágenes recortadas con MaskGroup."
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64
  },
  "density": {
    "touch": {
      "unit": "pt",
      "minTarget": 44,
      "type": {
        "display": [
          28,
          34,
          700
        ],
        "title": [
          20,
          26,
          600
        ],
        "body": [
          15,
          21,
          500
        ],
        "label": [
          13,
          18,
          600
        ],
        "caption": [
          12,
          16,
          500
        ]
      },
      "railWidth": 72,
      "panelGap": 12,
      "screenPadding": 16
    },
    "tv": {
      "unit": "px@1920x1080",
      "minTarget": 64,
      "type": {
        "display": [
          48,
          56,
          700
        ],
        "title": [
          32,
          40,
          600
        ],
        "body": [
          26,
          34,
          500
        ],
        "label": [
          22,
          28,
          600
        ],
        "caption": [
          20,
          26,
          500
        ]
      },
      "railWidth": 112,
      "panelGap": 20,
      "safeArea": {
        "x": 96,
        "y": 54
      },
      "note": "Texto mínimo 20 px. Margen seguro del 5% por overscan."
    }
  },
  "focus": {
    "ring": {
      "width": 4,
      "color": "accent.base",
      "offset": 3
    },
    "scale": 1.04,
    "durationMs": 120,
    "rule": "El foco nunca depende solo del color: siempre anillo + escala. En táctil no se muestra anillo."
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "easing": "ease-out",
    "rule": "Solo opacidad y traslación/escala. Sin animar desenfoque ni sombras (caro en TV)."
  },
  "elevation": {
    "rule": "Sin sombras ni desenfoque: la profundidad se marca con tonos de fondo (base < panel < raised)."
  },
  "icons": {
    "set": "Lucide",
    "license": "ISC",
    "stroke": 2,
    "sizes": {
      "touch": 22,
      "tv": 36
    },
    "note": "SVG en iOS y web; PNG exportados por tamaño para Roku."
  },
  "navigation": {
    "sections": [
      "live",
      "movies",
      "series",
      "myPrograms",
      "dvr",
      "settings"
    ],
    "labels_es": {
      "live": "TV en vivo",
      "movies": "Películas",
      "series": "Series",
      "myPrograms": "Mis programas",
      "dvr": "DVR",
      "settings": "Ajustes"
    },
    "listPattern": "Una sola lista visible: Grupos → canales del grupo; Atrás regresa a Grupos."
  }
}
