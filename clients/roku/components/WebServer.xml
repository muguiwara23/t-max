<?xml version="1.0" encoding="utf-8"?>
<!-- Página para configurar T-Max desde el celular: corre dentro del Roku, solo en la red local, protegida con PIN. -->
<component name="WebServer" extends="Task">
  <interface>
    <field id="port" type="integer" value="8888" />
    <field id="pin" type="string" />
    <field id="changed" type="integer" alwaysNotify="true" />
    <field id="status" type="string" />
  </interface>
  <script type="text/brightscript" uri="Common.brs" />
  <script type="text/brightscript" uri="WebServer.brs" />
</component>
