{
  "expo": {
    "name": "T-Max",
    "slug": "t-max",
    "version": "0.6.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0D",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.muguiwara23.tmax",
      "buildNumber": "16",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "T-Max se conecta a los servidores de tu red local que tú configures.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "expo-mpv",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "./plugins/without-push",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "T-Max guarda tus grabaciones del DVR en la galería de Fotos.",
          "savePhotosPermission": "T-Max guarda tus grabaciones del DVR en la galería de Fotos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/android-tv"
    ],
    "android": {
      "package": "com.muguiwara23.tmax",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0B0D"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.WAKE_LOCK"
      ]
    }
  }
}
