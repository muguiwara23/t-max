{
  "expo": {
    "name": "T-Max POC",
    "slug": "t-max-poc",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.muguiwara23.tmax.poc",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "T-Max se conecta a servidores de tu red local que tú configures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-mpv",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-secure-store"
    ]
  }
}
