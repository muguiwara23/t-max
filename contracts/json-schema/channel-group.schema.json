{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muguiwara23/t-max/contracts/json-schema/channel-group.schema.json",
  "title": "ChannelGroup",
  "type": "object",
  "required": [
    "id",
    "sourceId",
    "name",
    "kind"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/localId"
    },
    "sourceId": {
      "$ref": "common.schema.json#/$defs/localId"
    },
    "sourceGroupId": {
      "type": "string",
      "description": "category_id del proveedor, o el group-title si es M3U"
    },
    "name": {
      "type": "string"
    },
    "customName": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "live",
        "movie",
        "series"
      ]
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "userCreated": {
      "type": "boolean",
      "default": false
    },
    "sortIndex": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
