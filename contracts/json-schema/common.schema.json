{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muguiwara23/t-max/contracts/json-schema/common.schema.json",
  "title": "Definiciones comunes",
  "$defs": {
    "localId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador local generado en el dispositivo"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 en UTC"
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "description": "URI. Nunca debe contener credenciales en logs o exportaciones"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^secret:[a-z0-9-]+$",
      "description": "Referencia a un valor en SecureStore. El secreto nunca viaja en el modelo"
    },
    "capabilityState": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    }
  }
}
